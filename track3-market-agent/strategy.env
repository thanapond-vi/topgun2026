# Race-day strategy settings (no keys here). One STRATEGY_NAME=value per line; lines starting with # are off.
# Change -> python tools/quick_check.py -> python tools/change.py "reason" -> restart main.py right after a round's offers are sent.
# Modes tested in the arena (Net-market/17-race-day-playbook.md):
#
# M1 spread: 1 bag per lot per RFQ (oversupplied market, many rivals per bag)
# STRATEGY_MAX_PER_RFQ=1
# STRATEGY_MAX_PER_RFQ_LATE=1
#
# M2 rollback to 18 Nov settings
# STRATEGY_WAR_MODE=0
# STRATEGY_FLOOR_END_MARGIN=0.01
# STRATEGY_LAST_CAP_INST=0.86
#
# Nudge one buyer type's markup without restarting (read every round, limit ±0.01; playbook allows only -0.01):
# STRATEGY_OFFSET_COM=-0.01
# STRATEGY_OFFSET_INST=-0.01
# STRATEGY_OFFSET_SPEC=-0.01
#
# M6 Commercial raises +0.02 again after a sale (default +0.01 since 19 Nov)
# STRATEGY_STEP_UP_COM=0.02
#
# M5 turn off filling spare bag capacity (on by default since 19 Nov)
# STRATEGY_FILL_CAP=0
#
# Reload every round (no restart): MAX_PER_RFQ, MAX_PER_RFQ_LATE, WAR_MODE, FLOOR_END_MARGIN, LAST_CAP_INST, PACE, FILL_CAP, STEP_UP_COM, OFFSET_*.

# ACTIVE from race start (user 20 Nov 05:20): M1 suggestion, the rules accept it only when Instant is oversupplied
# or we sold < 60% in the last 2 rounds (HPC: mean rank 8.6 -> 8.0; costs ~0.7 in a calm day-18 market).
# To switch off during the game: put # in front of both lines (no restart needed).
STRATEGY_MAX_PER_RFQ=1
STRATEGY_MAX_PER_RFQ_LATE=1
