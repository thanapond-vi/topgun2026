# Race-day strategy settings (no keys here). One STRATEGY_NAME=value per line; lines starting with # are off.
# Change -> python tools/quick_check.py -> python tools/change.py "reason" -> restart main.py right after a round's offers are sent.
# Modes tested in the arena (Net-market/17-race-day-playbook.md):
#
# M1 spread: 1 bag per lot per RFQ (oversupplied market, many rivals per bag)
# STRATEGY_MAX_PER_RFQ=1
# STRATEGY_MAX_PER_RFQ_LATE=1
#
# M2 rollback to 18 Nov settings
# STRATEGY_WAR_MODE=0
# STRATEGY_FLOOR_END_MARGIN=0.01
# STRATEGY_LAST_CAP_INST=0.86
#
# Nudge one buyer type's markup without restarting (read every round, limit ±0.01; playbook allows only -0.01):
# STRATEGY_OFFSET_COM=-0.01
# STRATEGY_OFFSET_INST=-0.01
# STRATEGY_OFFSET_SPEC=-0.01
#
# M6 Commercial raises +0.02 again after a sale (default +0.01 since 19 Nov)
# STRATEGY_STEP_UP_COM=0.02
#
# M5 turn off filling spare bag capacity (on by default since 19 Nov)
# STRATEGY_FILL_CAP=0
#
# Reload every round (no restart): MAX_PER_RFQ, MAX_PER_RFQ_LATE, WAR_MODE, FLOOR_END_MARGIN, LAST_CAP_INST, PACE, FILL_CAP, STEP_UP_COM, OFFSET_*.

# ACTIVE from race start (user 20 Nov 05:20): M1 suggestion, the rules accept it only when Instant is oversupplied
# or we sold < 60% in the last 2 rounds (HPC: mean rank 8.6 -> 8.0; costs ~0.7 in a calm day-18 market).
# To switch off during the game: put # in front of both lines (no restart needed).
STRATEGY_MAX_PER_RFQ=1
STRATEGY_MAX_PER_RFQ_LATE=1

# 20 Nov after R4 (user OK): Commercial lost every bag R1-R4 (59 offers for 25 bags), Instant 97% filled.
# Rules apply it only while the market is oversupplied. To switch off: put # in front.
STRATEGY_OFFSET_COM=-0.01

# 20 Nov R7 (user OK, needs restart): after a sale keep the same price, no step-up
# (R2 won 0.96 -> R3 0.98 lost all; R5 won 0.95 -> R6 0.96 lost all). Replaces STEP_UP=0.01 from R6.
STRATEGY_STEP_UP=0
STRATEGY_STEP_UP_COM=0

# 20 Nov R8 (user OK, needs restart): R7-06 same buyer, all at 0.94 x our TV: lot 1 won, lots 2 and 5 lost
# -> the market values our top lots better than our TV says: sell high-TV lots first.
# Commercial cleared ~100-105/kg while the price-war floor kept us at 0.94: floor 0.94 -> 0.90.
STRATEGY_LOT_ORDER=tvHigh
# R11 (user: price range 0.82-0.85): floor under the cap, so a loss can lower the next price, a win keeps it
STRATEGY_WAR_FLOOR_MID=0.81
STRATEGY_FLOOR_MID=0.81

# 20 Nov R9 (user OK, needs restart): after OUTBID jump to last round's closing price instead of -0.03 steps.
# price_max comes from the best lot that fits the RFQ: divide by that lot's TV (R7-01: 117.59/128.82 = 0.913).
STRATEGY_CLOSE_MAX_TV=1

# 20 Nov R10 (user OK, needs restart; strategy.py reads STRATEGY_CAP_*): R9 lost all at 0.93.
# R9 winning est. price_max / best TV: Commercial ~0.89, Instant ~0.90-0.92, falling ~0.01/round.
# War mode used WAR_STEP_UP 0.01 instead of STEP_UP=0: set it to 0 too.
STRATEGY_CAP_COM=0.85
STRATEGY_CAP_INST=0.85
STRATEGY_WAR_STEP_UP=0

# 20 Nov R12 (user OK, needs restart): win or lose, cap each type at last round cheapest seller -0.01 (not below 0.82)
STRATEGY_TRACK_MIN=1
STRATEGY_TRACK_MIN_FLOOR=0.81
STRATEGY_TRACK_MIN_UNDER=0.018
# R13 (user: win all 15 bags left in R13-R15, keep only 10 for salvage 0.80): floors 0.81, end margin 0.01
STRATEGY_FLOOR_END_MARGIN=0.01
# R15 (user): sell to Commercial only
STRATEGY_ONLY_TYPES=COMMERCIAL
